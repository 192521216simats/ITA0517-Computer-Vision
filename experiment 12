
import cv2

# Read the image
img = cv2.imread(
    r"C:\Users\sharo\OneDrive\Pictures\nature image.jpg"
)

if img is None:
    print("Image not found! Check the image path.")
else:
    # Rotate image 270 degrees clockwise
    rotated = cv2.rotate(img, cv2.ROTATE_90_COUNTERCLOCKWISE)

    # Display original and rotated images
    cv2.imshow("Original Image", img)
    cv2.imshow("270 Degree Clockwise Rotation", rotated)

    # Save the rotated image
    cv2.imwrite(
        r"C:\Users\sharo\OneDrive\Desktop\ImageRotation\rotated270.jpg",
        rotated
    )

    print("Image rotated 270 degrees clockwise successfully!")
    print("Output saved as rotated270.jpg")

    cv2.waitKey(0)
    cv2.destroyAllWindows()
