
import cv2
import os
from tkinter import Tk, filedialog

# Select an image from your computer
root = Tk()
root.withdraw()

path = filedialog.askopenfilename(
    title="Select an Image",
    filetypes=[("Image files", "*.jpg *.jpeg *.png *.bmp")]
)

root.destroy()

if path == "":
    print("No image selected.")
else:
    img = cv2.imread(path)

    if img is None:
        print("Error: Unable to read the image.")
    else:
        h, w = img.shape[:2]

        # Increase image size by 2 times
        big = cv2.resize(
            img, (w * 2, h * 2),
            interpolation=cv2.INTER_CUBIC
        )

        # Reduce image size by half
        small = cv2.resize(
            img, (w // 2, h // 2),
            interpolation=cv2.INTER_AREA
        )

        # Display the images
        cv2.imshow("Original Image", img)
        cv2.imshow("Bigger Image", big)
        cv2.imshow("Smaller Image", small)

        # Save the output images
        folder = os.path.dirname(path)

        cv2.imwrite(os.path.join(folder, "bigger_image.jpg"), big)
        cv2.imwrite(os.path.join(folder, "smaller_image.jpg"), small)

        print("Image scaling completed successfully!")
        print("Original size:", w, "x", h)
        print("Bigger size:", w * 2, "x", h * 2)
        print("Smaller size:", w // 2, "x", h // 2)

        cv2.waitKey(0)
        cv2.destroyAllWindows()
