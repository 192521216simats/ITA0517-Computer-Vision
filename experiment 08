
import cv2

video_path = r"C:\Users\sharo\OneDrive\New folder\VideoProcessing\input.mp4"

cap = cv2.VideoCapture(video_path)

if not cap.isOpened():
    print("Video not found. Check the file location.")
else:
    fps = cap.get(cv2.CAP_PROP_FPS)

    if fps <= 0:
        fps = 30

    print("Video loaded successfully")

    # Normal speed
    while True:
        ret, frame = cap.read()
        if not ret:
            break
        cv2.imshow("Normal Speed", frame)
        if cv2.waitKey(max(1, int(1000 / fps))) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

    # Slow motion
    cap = cv2.VideoCapture(video_path)
    while True:
        ret, frame = cap.read()
        if not ret:
            break
        cv2.imshow("Slow Motion", frame)
        if cv2.waitKey(max(1, int(2000 / fps))) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

    # Fast motion: skip alternate frames
    cap = cv2.VideoCapture(video_path)
    while True:
        ret, frame = cap.read()
        if not ret:
            break

        ret, next_frame = cap.read()
        if not ret:
            cv2.imshow("Fast Motion", frame)
            cv2.waitKey(1)
            break

        cv2.imshow("Fast Motion", next_frame)
        if cv2.waitKey(max(1, int(1000 / fps))) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()
