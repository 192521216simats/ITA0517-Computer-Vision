
import cv2

video_path = "input.mp4"

def play_video(mode):
    cap = cv2.VideoCapture(video_path)

    if not cap.isOpened():
        print("Error: Video not found!")
        return

    fps = cap.get(cv2.CAP_PROP_FPS)

    if fps <= 0:
        fps = 30

    delay = max(1, int(1000 / fps))

    if mode == "Slow Motion":
        delay = delay * 2

    count = 0

    while True:
        ret, frame = cap.read()

        if not ret:
            break

        if mode == "Fast Motion":
            count += 1
            if count % 2 == 0:
                continue

        cv2.imshow(mode, frame)

        if cv2.waitKey(delay) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()


play_video("Normal Speed")
play_video("Slow Motion")
play_video("Fast Motion")
